# Path CSV yang di-mount read-only oleh dashboard/API (Shared host folder collector)
NTT_DATA_DIR=/home/mci/app/SCRIPT/DASHBOARD-EOC/dashboard/data/ntt

# PostgreSQL collector_bencana_ntt (Sesuai container collector-ntt)
POSTGRES_HOST=db-postgres
POSTGRES_PORT=5432
POSTGRES_DB=collector_bencana_ntt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Password Admin untuk Kelola & Import CSV Data NTT
