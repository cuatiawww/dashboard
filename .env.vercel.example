# ================================================================
# KONFIGURASI ENVIRONMENT VARIABLES UNTUK DEPLOYMENT KE VERCEL
# Dashboard SIPKK / EOC (Next.js)
# ================================================================

# 1. URL Backend Produksi SIPKK
# PENTING: Di Vercel HARUS mengarah ke server publik, BUKAN localhost / sipkk-baru.test
SIPKK_BACKEND_BASE_URL=https://sipkk-new.mediaciptainformasi.co.id
NEXT_PUBLIC_SIPKK_BACKEND_BASE_URL=https://sipkk-new.mediaciptainformasi.co.id

# 2. Token Autentikasi API Internal SIPKK
SIPKK_DASHBOARD_TTOKEN=

# 3. Base Path Routing
# Kosongkan atau jangan diisi jika ingin dashboard diakses langsung di root: https://<domain-vercel>.vercel.app/
# Isi "/dashboard-eoc" jika ingin dashboard diakses di subpath: https://<domain-vercel>.vercel.app/dashboard-eoc
NEXT_PUBLIC_BASE_PATH=

# 4. Layanan Eksternal & AI Key
API_INDONESIA_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# 5. URL Navigasi Media Monitoring & NLP Kemenkes
NEXT_PUBLIC_MEDIA_MONITORING_URL=https://pusatkrisis.kemkes.go.id/dashboard-media
NEXT_PUBLIC_NLP_URL=https://pusatkrisis.kemkes.go.id/nlp/

# 6. Google Apps Script Live API (Data Korban Jiwa, Pengungsi, Faskes Terdampak & Upaya Kesehatan)
GOOGLE_APPS_SCRIPT_KORBAN_URL=https://script.google.com/macros/s/AKfycbwt-VTU0wNteo_03CyCJIALO2KZ8I6cyya049A16OnslSal6nKqzw7e-y_JIYPIjUZn/exec
NEXT_PUBLIC_NTT_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwt-VTU0wNteo_03CyCJIALO2KZ8I6cyya049A16OnslSal6nKqzw7e-y_JIYPIjUZn/exec

# 7. Fitur Surveilans Penyakit Bencana (Hidden sementara)
NEXT_PUBLIC_ENABLE_SURVEILANS_PENYAKIT=false
